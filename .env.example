# ────────────────────────────────────────────────────────────
# 부개원 한의원 — 환경 변수 템플릿
# .env.local로 복사하여 실제 값을 채웁니다. .env.local은 git에서 추적되지 않습니다.
# ────────────────────────────────────────────────────────────

# ─── 사이트 ───────────────────────────────────────
# 절대 URL. metadataBase, sitemap, OG 이미지 등에 사용.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 — 서버 코드(@/lib/supabase/admin)에서만 사용.
# 절대 NEXT_PUBLIC_ prefix 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Resend) ───────────────────────────────
# 접수 알림 메일·환자 안내 메일 발송용. https://resend.com/api-keys
RESEND_API_KEY=

# ─── 외부 채널 ────────────────────────────────────
# 네이버폼 → /api/webhooks/naver-form 으로 POST할 때 검증용 비밀.
NAVER_FORM_WEBHOOK_SECRET=

# 카카오 채널 식별자 (예: _xfFxgC) — 딥링크 생성용.
NEXT_PUBLIC_KAKAO_CHANNEL_ID=

# ─── Analytics ────────────────────────────────────
# https://posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
